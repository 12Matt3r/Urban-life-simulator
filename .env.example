# ----------------------------------
# Supabase Configuration
# ----------------------------------
# These variables are required for the game to connect to the Supabase backend
# for features like cloud saves and leaderboards.
#
# Copy this file to .env and fill in your project's values.
# You can find these in your Supabase project settings under "API".

VITE_SUPABASE_URL="YOUR_SUPABASE_PROJECT_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"